define task update {}

define task install {
	input {
		withGui "with GUI": Bool

		usbAccess: Bool

		lowPerformance: Bool


		packageManager: enum("dnf", "apt")

		bashLogoutClearConsole: Bool

		systemBashRcFilePath: String

		systemBashGitPromptFilePath: String

		androidDevelopment: Bool
	}

	inputPresets {
		"Fedora 41" {
			packageManager = "dnf"
			bashLogoutClearConsole = no
			systemBashRcFilePath = "/etc/bashrc"
			systemBashGitPromptFilePath = "/usr/share/git-core/contrib/completion/git-prompt.sh"
		}

		"Ubuntu 22.04" {
			packageManager = "apt"
			bashLogoutClearConsole = yes
			systemBashRcFilePath = "/etc/bash.bashrc"
			systemBashGitPromptFilePath = "/usr/lib/git-core/git-sh-prompt"
		}

		"Android Termux" {
			withGui = no
			usbAccess = no
			lowPerformance = yes
		}
	}
}
