include (
	"shell"
	"cfg"
	"bin"
	"custom-locale"
)

task updateRemoteFiles {
	ExecTask "cfg".updateRemoteFiles
	ExecTask "bin".updateRemoteFiles
}

task install(
	dailyDriver: Bool,
	usingBashPromptCommand: Bool,
	withGui: Bool,
	usbAccess: Bool,
	useGitCommitSigning: Bool,
	TODO,
) {
	ExecTask "shell".install(dailyDriver, usingBashPromptCommand, withGui, usbAccess)

	ExecTask "cfg".install(useGitCommitSigning, withGui)

	ExecTask "bin".install(withGui, TODO) # TODO

	if (withGui) {
		ExecTask "custom-locale".install
	}
}

task install:fedora41-dailyDriver {
	ExecTask install(
		dailyDriver: true,
		usingBashPromptCommand: true,
		withGui: true,
		usbAccess: true,
		TODO,
	)
}

