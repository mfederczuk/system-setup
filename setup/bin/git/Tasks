task install {
	Copy
		files=(
			"append.sh" as "git-append",
			"diff-and-apply.bash" as "git-diff-and-apply",
			"fixup-immediately.sh" as "git-fixup-immediately",
			"ignore.sh" as "git-ignore",
			"iterate.sh" as "git-iterate",
			"merge-into.sh" as "git-merge-into",
			"prune-local-branches.bash" as "git-prune-local-branches",
			"purge.sh" as "git-purge",
			"search.bash" as "git-search",
			"sed.bash" as "git-sed",
			"sync.sh" as "git-sync",
			"unstage.sh" as "git-unstage",
			"wip-dump.sh" as "git-wip-dump",

			"preferred-editor.sh" as "_git_preferred_editor",
		)
		into
		directory="$HOME/.local/bin"
}
