include (
	"neovim"
	"git"
	"gtk"
	"ghostty"
	"codium"
	"intellij-idea"
)

task updateRemoteFiles {
	ExecTask "neovim".updateColorscheme
}

task install(useGitCommitSigning: Bool, withGui: Bool) {
	Copy file="vimrc.vim" to file="$HOME/.vimrc"
	ExecTask "neovim".install

	ExecTask "git".install(useGitCommitSigning)

	Copy file="tmux.conf" to file="$XDG_CONFIG_HOME/tmux/tmux.conf"

	Copy file="npmrc" to file="$XDG_CONFIG_HOME/npm/npmrc"

	Copy file="mpv.conf" to file="$XDG_CONFIG_HOME/mpv/mpv.conf"

	if (withGui) {
		ExecTask "gtk".install

		Copy file="custom-gnome-shell-theme.css" to file="$HOME/.themes/custom/gnome-shell/gnome-shell.css"

		ExecTask "ghostty".install

		ExecTask "codium".install

		ExecTask "intellij-idea".install
	}
}
