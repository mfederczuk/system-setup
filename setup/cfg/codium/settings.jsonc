// SPDX-License-Identifier: CC0-1.0
{
	"editor.insertSpaces": false,
	"editor.renderLineHighlight": "all",
	"editor.renderWhitespace": "all",
	"editor.rulers": [120],
	"editor.scrollBeyondLastColumn": 8,

	"explorer.sortOrderLexicographicOptions": "upper",

	"files.autoSave": "afterDelay",
	"files.autoSaveDelay": 1001,
	"files.eol": "\n",
	"files.insertFinalNewline": true,
	"files.trimFinalNewlines": true,

	"telemetry.telemetryLevel": "off",

	"window.dialogStyle": "custom",
	"window.titleBarStyle": "custom",

	"workbench.colorTheme": "Default Dark Modern",
	"workbench.colorCustomizations": {
		"[Default Dark Modern]": {
			// Same as "activityBar.activeBorder" but with an alpha value of 0x1F.
			"activityBar.activeBackground": "#0078d41f",
		},
	},
	"workbench.list.openMode": "doubleClick",
	"workbench.tree.indent": 16,

	"[git-commit]": {
		"editor.rulers": [50, 72],
		"workbench.editor.restoreViewState": false,
	},

	"cSpell.language": "en,en-US,en-GB",
	"cSpell.customDictionaries": {
		"custom-user-public": {
			"name": "custom-user-public",
			"path": "~/.config/VSCodium/User/cSpell-dictionaries/public.txt",
			"addWords": true,
			"scope": "user",
		},
		"custom-user-private": {
			"name": "custom-user-private",
			"path": "~/.config/VSCodium/User/cSpell-dictionaries/private.txt",
			"addWords": true,
			"scope": "user",
		},
	},
	"cSpell.dictionaries": [
		"git",
		"lorem-ipsum",
		"custom-user-public",
		"custom-user-private",
	],

	"redhat.telemetry.enabled": false,
	"xml.format.maxLineWidth": 120,

	//#region Todo Tree

	"todo-tree.filtering.excludeGlobs": [
		"**/.git/**",
		"**/node_modules/**",
	],
	"todo-tree.general.tags": [
		"FIXME",
		"TODO",
		"WIP",
	],
	"todo-tree.highlights.customHighlight": {
		"FIXME": {
			"foreground": "#EFEFEF",
			"background": "#EF0000",
			"opacity": 50,
			"icon": "alert",
			"iconColour": "#BF2F2F",
			"gutterIcon": true,
		},
		"TODO": {
			"foreground": "#EFEFEF",
			"background": "#EFEF00",
			"opacity": 45,
			"icon": "issue-opened",
			"iconColour": "#CFCF3F",
		},
		"WIP": {
			"foreground": "#9F9F9F",
			"background": "#000000",
			"opacity": 60,
			"icon": "pencil",
			"iconColour": "#9F9F9F",
			"gutterIcon": true,
		},
	},
	"todo-tree.tree.flat": true,
	"todo-tree.tree.showCountsInTree": true,

	//#endregion
}
