task install(useGitCommitSigning: Bool) {
	Copy
		files=(
			"aliases.gitconfig",
			"pretty-formats.gitconfig",
			if (useGitCommitSigning) "signing.gitconfig",
			"global.gitconfig" as "config",

			"global.gitignore" as "ignore",
		)
		into
		directory="$XDG_CONFIG_HOME/git"
}
