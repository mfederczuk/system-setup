# vim: syntax=gitconfig

# SPDX-License-Identifier: CC0-1.0

[core]
	editor = _git_preferred_editor

	# -+X -> enable termcap initialization/deinitialization (disabled by default for whatever reason)
	pager = less --quit-if-one-screen --ignore-case --quit-on-intr --LONG-PROMPT --RAW-CONTROL-CHARS --chop-long-lines -+X --file-size --

[diff]
	noPrefix = true

[format]
	pretty = custom-fuller

[gpg]
	# git uses by default the `gpg` binary, which on some older systems may still be GnuPG v1.x, so let's explicitly
	# tell git to use v2.x instead
	program = gpg2

[grep]
	lineNumber = true
	patternType = extended

[init]
	defaultBranch = master

[merge]
	conflictStyle = diff3
	ff = false
	tool = vimdiff

# <https://mergiraf.org/usage.html#registration-as-a-git-merge-driver>
[merge "mergiraf"]
	name = mergiraf
	driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L

[mergetool]
	keepBackup = false

[pull]
	ff = only

[rebase]
	autoStash = true
	autoSquash = true
	missingCommitsCheck = warn
	rebaseMerges = true

[stash]
	showIncludeUntracked = true
	showPatch = true
	showStat = true

[status]
	showStash = true

[user]
	useConfigOnly = true

[include]
	path = pretty-formats.gitconfig
	path = aliases.gitconfig
	path = secret.gitconfig
