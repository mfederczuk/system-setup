task open_toolbox_download_page_if_not_installed {
	exec "./open-toolbox-download-page-if-not-installed" reverse {}
	print_info "JetBrains Toolbox must be downloaded and installed manually (download webpage has been opened with the default web browser if not yet installed)"
}

task zip_settings {
	exec "./zip-settings"
		reverse {
			exec "rm -f settings.zip"
		}

	print_info "JetBrains IDE settings must be import manually"
}
