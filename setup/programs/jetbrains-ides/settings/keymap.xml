<keymap version="1" name="Custom GNOME" parent="Default for GNOME">
	<!-- #region redo -->

	<!-- Default is [Ctrl]+[Y] -->
	<action id="EditorDeleteLine" />

	<action id="$Redo">
		<keyboard-shortcut first-keystroke="shift ctrl z" />
		<keyboard-shortcut first-keystroke="shift alt back_space" />
		<keyboard-shortcut first-keystroke="ctrl y" />
	</action>

	<!-- #endregion -->

	<!-- #region close -->

	<!-- Called "Extend Selection" in the UI and the default is [Ctrl]+[W] -->
	<action id="EditorSelectWord" />

	<action id="CloseContent">
		<keyboard-shortcut first-keystroke="ctrl f4" />
		<keyboard-shortcut first-keystroke="ctrl w" />
	</action>

	<!-- #endregion -->

	<!-- #region find & replace -->

	<!-- Default is [Ctrl]+[F] and [Alt]+[Shift]+[3] -->
	<action id="Find">
		<keyboard-shortcut first-keystroke="shift alt 3" />
	</action>

	<action id="Replace">
		<keyboard-shortcut first-keystroke="ctrl r" />
		<keyboard-shortcut first-keystroke="ctrl f" />
	</action>

	<!--
		These inherit from `Find` and since we've removed [Ctrl]+[F] from it, they wouldn't have it anymore, so we give
		it back to them.
	-->
	<action id="SpeedSearch">
		<keyboard-shortcut first-keystroke="shift alt 3" />
		<keyboard-shortcut first-keystroke="ctrl f" />
	</action>
	<action id="Terminal.Find">
		<keyboard-shortcut first-keystroke="shift alt 3" />
		<keyboard-shortcut first-keystroke="ctrl f" />
	</action>
	<action id="Vcs.Log.GoToRef">
		<keyboard-shortcut first-keystroke="shift alt 3" />
		<keyboard-shortcut first-keystroke="ctrl f" />
	</action>

	<!-- #endregion -->

	<!-- #region reformat -->

	<!-- Default is [Ctrl]+[Shift]+[F] -->
	<action id="FindInPath" />

	<action id="ReformatCode">
		<keyboard-shortcut first-keystroke="ctrl alt l" />
		<keyboard-shortcut first-keystroke="shift ctrl f" />
	</action>

	<!-- #endregion -->

	<!-- #region rename -->

	<!-- Default is [F2] -->
	<action id="GotoNextError" />

	<action id="RenameElement">
		<keyboard-shortcut first-keystroke="shift f6" />
		<keyboard-shortcut first-keystroke="f2" />
	</action>

	<!-- #endregion -->

	<!-- #region comment toggling -->

	<action id="CommentByLineComment">
		<keyboard-shortcut first-keystroke="ctrl slash" />
		<keyboard-shortcut first-keystroke="ctrl divide" />
		<keyboard-shortcut first-keystroke="ctrl number_sign" />
	</action>

	<action id="CommentByBlockComment">
		<keyboard-shortcut first-keystroke="shift ctrl slash" />
		<keyboard-shortcut first-keystroke="shift ctrl divide" />
		<keyboard-shortcut first-keystroke="shift ctrl number_sign" />
	</action>

	<!-- #endregion -->

	<action id="EditorToggleColumnMode">
		<keyboard-shortcut first-keystroke="shift alt insert" />
		<keyboard-shortcut first-keystroke="alt x" />
	</action>
</keymap>
