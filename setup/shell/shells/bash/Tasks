include (
	"lib"
	"completions"
)

task updateRemoteFiles {
	ExecTask "completions".updateRemoteFiles
}

task install(
	dailyDriver: Bool,
	usingBashPromptCommand: Bool,
	withGui: Bool,
	usbAccess: Bool,
	systemBashRcFilePath: String,
) {
	ExecTask "lib".install(dailyDriver, usingBashPromptCommand, withGui, usbAccess)

	Copy files=("funcs.bash", "aliases.bash") into directory="$XDG_CONFIG_HOME/bash"

	# Required for the history file.
	CreateDirectories "$XDG_STATE_HOME/bash"

	bashRcFile = PreProcessShellscript "rc.template.bash" inputs=(systemBashRcFilePath)

	Copy
		files=(
			bashRcFile as ".bashrc",
			"logout.bash" as ".bash_logout",
		)
		into
		directory="$HOME"
}
