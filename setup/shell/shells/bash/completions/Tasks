include (
	"git"
)

task updateRemoteFiles {
	ExecFile "update-adb-completion"
	ExecFile "update-gradle-completion"
}

task install {
	Copy
		files=(
			"adb.bash",
			"alert.bash",
			"doas.bash",
			"gradle.bash",
		)
		into
		directory="$XDG_CONFIG_HOME/bash/completions"

	ExecTask "git".install
}
