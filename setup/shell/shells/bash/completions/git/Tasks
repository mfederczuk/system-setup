task install {
	Copy
		files=(
			"append.bash" as "git-append.bash",
			"diff-and-apply.bash" as "git-diff-and-apply.bash",
			"iterate.bash" as "git-iterate.bash",
			"merge-into.bash" as "git-merge-into.bash",
			"prune-local-branches.bash" as "git-prune-local-branches.bash",
			"sync.bash" as "git-sync.bash",
		)
		into
		directory="$XDG_CONFIG_HOME/bash/completions"
}
