task install(
	dailyDriver: Bool,
	usingBashPromptCommand: Bool,
	withGui: Bool,
	usbAccess: Bool,
) {
	Copy
		files=(
			"cd-dot-dot.bash",
			"check-name.bash",
			"countfiles.bash",
			"curlrr.bash",
			"full-reset.bash",
			if (dailyDriver) "goodnight.bash",
			"gotmp.bash",
			"gti.bash",
			"man.bash",
			"pkgsup.bash",
			if (usingBashPromptCommand) "prompt_command.bash",
			"rmcwd.bash",
			"sequence-commands.bash",
			if (withGui) "ssh-wrapper.bash",
			"unwrap.bash",
			if (withGui) "xclip.bash",
			if (usbAccess) "yeet.bash",
		)
		into
		directory="$XDG_CONFIG_HOME/bash/lib"
}
