task fetch-remote-files {
	ExecTask neovim.fetch-colorscheme-codedark
}



task install-all-for(distro: enum("fedora-41", "ubuntu-22.04", "android-termux"), with-gui: Bool) {
	ExecTask "vim"/install-for(distro)
	ExecTask "neovim"/install-for(distro)

	ExecTask "git"/install-for(distro)

	if distro != "android-termux" {
		ExecTask "tmux"/install-for(distro)
	}

	ExecTask "npm"/install-for(distro)

	if with-gui and distro == "fedora-41" {
		ExecTask "mpv"/install-for-fedora-41
	}
}

task install-configuration-files(include-git-commit-signing: Bool, with-gui: Bool, is-distro-fedora-41: Bool) {
	ExecTask "vim"/install-configuration-files
	ExecTask "neovim"/install-configuration-files

	ExecTask "git"/install-configuration-files(include-commit-signing: include-git-commit-signing)

	ExecTask "npm"/install-configuration-files

	if with-gui and is-distro-fedora-41 {
		ExecTask "mpv"/install-configuration-files
	}
}
