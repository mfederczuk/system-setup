task enable-fedora-41-copr (
	ExecShell as root "dnf copr enable pgdev/ghostty"
)

task install-for-fedora-41 {
	ExecShell as root "dnf install ghostty"
}

task install-configuration-files {
	Copy file="theme-ambience-from-terminator.cfg" to file="$XDG_CONFIG_HOME/ghostty/themes/Ambience from Terminator"

	Copy file="config.cfg" to file="$XDG_CONFIG_HOME/ghostty/config"
}
