task fetch-colorscheme-codedark {
	ExecFile "fetch-colorscheme-codedark"
}

task install-for(distro: enum("fedora-41", "ubuntu-22.04", "android-termux")) {
	switch distro {
		case "fedora-41" {
			ExecShell as root "dnf install neovim"
		}

		case "ubuntu-22.04" {
			ExecShell as root "apt install neovim"
		}

		case "android-termux" {
			ExecShell "pkg install neovim"
		}
	}
}

task install-configuration-files {
	Copy file="colorscheme-codedark.vim" to file="$XDG_CONFIG_HOME/nvim/colors/codedark.vim"

	Copy file="init.vim" to file="$XDG_CONFIG_HOME/nvim/init.vim"
}
