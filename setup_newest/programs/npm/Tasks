task install-for(distro: enum("fedora-41", "ubuntu-22.04", "android-termux")) {
	switch distro {
		case "fedora-41" {
			ExecShell as root "dnf install nodejs-npm"
		}

		case "ubuntu-22.04" {
			ExecShell as root "apt install npm"
		}

		case "android-termux" {
			ExecShell "pkg install nodejs"
		}
	}
}

task install-configuration-files {
	Copy file="npmrc" to file="$XDG_CONFIG_HOME/npm/npmrc"
}
