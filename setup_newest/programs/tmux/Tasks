task install-for(distro: enum("fedora-41", "ubuntu-22.04")) {
	switch distro {
		case "fedora-41" {
			ExecShell as root "dnf install tmux"
		}

		case "ubuntu-22.04" {
			ExecShell as root "apt install tmux"
		}
	}
}

task install-configuration-files {
	Copy file="tmux.conf" to file="$XDG_CONFIG_HOME/tmux/tmux.conf"
}
