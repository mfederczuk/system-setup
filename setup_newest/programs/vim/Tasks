task install-for(distro: enum("fedora-41", "ubuntu-22.04", "android-termux")) {
	switch distro {
		case "fedora-41" {
			ExecShell as root "dnf install vim"
		}

		case "ubuntu-22.04" {
			ExecShell as root "apt install vim"
		}

		case "android-termux" {
			ExecShell "pkg install vim"
		}
	}
}

task install-configuration-files {
	# TODO: <https://wiki.archlinux.org/title/XDG_Base_Directory#Support>
	Copy file="rc.vim" to file="$HOME/.vimrc"
}
